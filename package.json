{
  "name": "onboardflow",
  "version": "1.0.0",
  "description": "Employee Onboarding & Asset Provisioning POC using Temporal Technologies",
  "private": true,
  "workspaces": ["backend", "frontend"],
  "scripts": {
    "install:all": "npm install && npm install --workspace=backend && npm install --workspace=frontend",
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "setup:db": "npm run db:migrate --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
